# === 推奨: 各利用者の PC にパスワード暗号化で保存（Vercel 公開向け） ===
# local … 既定。Neon 不要。ブラウザ localStorage に暗号化保存
# cloud … Neon + Google ログイン（従来モード）
NEXT_PUBLIC_STORAGE_MODE=local

# Anthropic の API キー（AI に相談機能・発展課題）
ANTHROPIC_API_KEY=
# 任意: モデル名（既定 claude-sonnet-4-5）
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- 以下は cloud モード（NEXT_PUBLIC_STORAGE_MODE=cloud）のときのみ ---

# Auth.js / Google OAuth
AUTH_SECRET=openssl-rand-base64-32 で生成
AUTH_GOOGLE_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# ログイン制限（省略時は Google アカウントなら誰でも可）
# ALLOWED_EMAIL=you@example.com
ALLOW_ANY_GOOGLE_USER=true

# Neon PostgreSQL（scripts/init-db.sql を実行後の接続文字列）
DATABASE_URL=postgresql://...

# Vercel デプロイ時にホスト検証エラーが出る場合
# AUTH_TRUST_HOST=true

# --- ローカル開発のみ: パスワードなしで平文 localStorage（開発の手軽さ用） ---
# AUTH_BYPASS=true
# NEXT_PUBLIC_AUTH_BYPASS=true
