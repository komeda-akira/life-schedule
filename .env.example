# Auth.js / Google OAuth（Google Cloud Console で OAuth クライアントを作成）
AUTH_SECRET=openssl-rand-base64-32 で生成
AUTH_GOOGLE_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# ログイン制限（省略時は Google アカウントなら誰でも可）
# 特定メールのみ許可する場合: you@example.com または a@x.com,b@y.com
# ALLOWED_EMAIL=you@example.com

# 明示的に全 Google ユーザーを許可（ALLOWED_EMAIL より優先）
ALLOW_ANY_GOOGLE_USER=true

# Neon PostgreSQL（scripts/init-db.sql を実行後の接続文字列）
DATABASE_URL=postgresql://...

# Google AI Studio の API キー（AI に相談機能）
GEMINI_API_KEY=
# 任意: モデル名（既定 gemini-2.5-flash）
# GEMINI_MODEL=gemini-2.5-flash

# Vercel 本番では通常不要（自動推論）。ローカルで必要な場合のみ
# AUTH_URL=http://localhost:3000

# Vercel デプロイ時にホスト検証エラーが出る場合
# AUTH_TRUST_HOST=true

# ローカル開発のみ: Google ログインをスキップして localStorage で表示
# AUTH_BYPASS=true
# NEXT_PUBLIC_AUTH_BYPASS=true
